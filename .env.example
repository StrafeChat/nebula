# HTTP (default 4010 — separate from equinox-api 4000 / stargate 4001)
PORT=4010

# Where objects are stored on disk (Docker: /data)
DATA_DIR=./data

# Required for PUT /v1/... and DELETE /v1/... (use Authorization: Bearer <secret>)
# Leave unset to disable mutating operations (read-only CDN).
# UPLOAD_SECRET=

# Max upload body size in megabytes (default 25)
# HTTP_BODY_LIMIT_MB=25

# Browser CORS: comma-separated origins. Empty = mirror any Origin header (dev only).
# CORS_ORIGINS=https://web.strafe.chat

# Cache-Control max-age for successful GET (seconds, default 86400)
# CACHE_CONTROL_MAX_AGE=86400

# On start, copy the bundled Unicode emoji sets into the store so the web client renders
# emoji from this instance instead of a third-party CDN. Idempotent and non-fatal.
# SEED_EMOJI=true
# Where those bundled sets live (populated by scripts/fetch-emoji.sh; /app/emoji in Docker).
# EMOJI_ASSETS_DIR=./emoji
